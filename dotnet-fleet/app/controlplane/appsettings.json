{
  "Kestrel": {
    "Endpoints": {
      "Fleet": {
        "Url": "https://0.0.0.0:8443",
        "Protocols": "Http2",
        "Certificate": {
          "Path": "/etc/fleet/tls/controlplane.crt",
          "KeyPath": "/etc/fleet/tls/controlplane.key"
        }
      },
      "Admin": { "Url": "http://127.0.0.1:5080", "Protocols": "Http1" }
    },
    "Limits": {
      "Http2": { "KeepAlivePingDelay": "00:00:20", "KeepAlivePingTimeout": "00:00:10" }
    }
  }
}

diff --git a/with-nfltr/shared/DialChannel.cs b/with-nfltr/shared/DialChannel.cs
new file mode 100644
index 0000000..6cf8c68
--- /dev/null
+++ b/with-nfltr/shared/DialChannel.cs
@@ -0,0 +1,84 @@
+// Optional: reach an agent's service with no connect: mapping, one
+// `nfltr cat pipe` child process per HTTP/2 connection (a large or changing fleet).
+using System.Diagnostics;
+using Grpc.Net.Client;
+
+static class DialChannel
+{
+    // Reach <agent>/<service> with no mapping configured: every HTTP/2
+    // connection of the channel is one `nfltr cat pipe` child whose stdin/stdout
+    // are the connection. plain: a plain session (--plain), for a service not
+    // end-to-end encrypted; otherwise an enrolled machine's sessions are in
+    // organisation mode.
+    public static GrpcChannel For(string target, bool plain, string nfltr)
+    {
+        var handler = new SocketsHttpHandler
+        {
+            ConnectCallback = (_, _) => ValueTask.FromResult<Stream>(DialStream.Start(nfltr, target, plain)),
+        };
+        return SidecarChannel.Channel("http://localhost", handler);
+    }
+}
+
+// The stdin/stdout of one `nfltr cat pipe` process as a duplex stream. stderr
+// is JSON lines (open, close, error) and is read so it never blocks dial.
+// The exit code is typed: 3 not_found, 4 refused, 5 unreachable, 7 not
+// in organisation mode, 10 e2ee_client_refused, ...
+// (https://nfltr.xyz/docs); here a failed
+// open surfaces as the gRPC call's UNAVAILABLE.
+sealed class DialStream : Stream
+{
+    readonly Process proc;
+    readonly Stream read, write;
+
+    DialStream(Process proc)
+    {
+        this.proc = proc;
+        read = proc.StandardOutput.BaseStream;
+        write = proc.StandardInput.BaseStream;
+    }
+
+    public static DialStream Start(string nfltr, string target, bool plain)
+    {
+        var psi = new ProcessStartInfo(nfltr)
+        {
+            RedirectStandardInput = true,
+            RedirectStandardOutput = true,
+            RedirectStandardError = true,
+            UseShellExecute = false,
+        };
+        foreach (var a in new[] { "cat", "pipe", target, "--exit-with-parent" }) psi.ArgumentList.Add(a);
+        if (plain) psi.ArgumentList.Add("--plain");
+        var proc = Process.Start(psi)!;
+        if (OperatingSystem.IsWindows()) Job.KillOnClose(proc);
+        proc.ErrorDataReceived += (_, e) => { if (e.Data is { } line) Console.Error.WriteLine($"dial {target}: {line}"); };
+        proc.BeginErrorReadLine();
+        return new DialStream(proc);
+    }
+
+    public override bool CanRead => true;
+    public override bool CanWrite => true;
+    public override bool CanSeek => false;
+    public override int Read(byte[] buffer, int offset, int count) => read.Read(buffer, offset, count);
+    public override ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken ct = default) => read.ReadAsync(buffer, ct);
+    public override void Write(byte[] buffer, int offset, int count) => write.Write(buffer, offset, count);
+    public override ValueTask WriteAsync(ReadOnlyMemory<byte> buffer, CancellationToken ct = default) => write.WriteAsync(buffer, ct);
+    public override void Flush() => write.Flush();
+    public override Task FlushAsync(CancellationToken ct) => write.FlushAsync(ct);
+
+    protected override void Dispose(bool disposing)
+    {
+        if (disposing)
+        {
+            try { write.Dispose(); } catch (IOException) { } // stdin EOF: dial half-closes and exits
+            try { if (!proc.WaitForExit(2000)) proc.Kill(); } catch (InvalidOperationException) { }
+            proc.Dispose();
+        }
+        base.Dispose(disposing);
+    }
+
+    public override long Length => throw new NotSupportedException();
+    public override long Position { get => throw new NotSupportedException(); set => throw new NotSupportedException(); }
+    public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();
+    public override void SetLength(long value) => throw new NotSupportedException();
+}
diff --git a/with-nfltr/shared/Job.cs b/with-nfltr/shared/Job.cs
new file mode 100644
index 0000000..9daba1c
--- /dev/null
+++ b/with-nfltr/shared/Job.cs
@@ -0,0 +1,75 @@
+// Windows: a child process (an nfltr sidecar or dial) in a Job Object with
+// JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE dies with this process, however this
+// process ends. nfltr's --exit-with-parent covers the same from the child's
+// side. As in connect/csharp/DialClient, with one job for all children.
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+
+static class Job
+{
+    const int JobObjectExtendedLimitInformation = 9;
+    const uint JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE = 0x2000;
+    static IntPtr handle; // kept open for this process's life; closing it kills the job
+
+    static readonly object mu = new();
+
+    // One job for every child of this process.
+    public static void KillOnClose(Process p)
+    {
+        lock (mu)
+        {
+            if (handle == IntPtr.Zero) handle = Create();
+        }
+        if (!AssignProcessToJobObject(handle, p.Handle))
+            throw new System.ComponentModel.Win32Exception();
+    }
+
+    static IntPtr Create()
+    {
+        var job = CreateJobObject(IntPtr.Zero, null);
+        var info = new JOBOBJECT_EXTENDED_LIMIT_INFORMATION();
+        info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+        int size = Marshal.SizeOf(info);
+        IntPtr ptr = Marshal.AllocHGlobal(size);
+        try
+        {
+            Marshal.StructureToPtr(info, ptr, false);
+            if (!SetInformationJobObject(job, JobObjectExtendedLimitInformation, ptr, (uint)size))
+                throw new System.ComponentModel.Win32Exception();
+        }
+        finally { Marshal.FreeHGlobal(ptr); }
+        return job;
+    }
+
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    static extern IntPtr CreateJobObject(IntPtr attrs, string? name);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    static extern bool SetInformationJobObject(IntPtr job, int infoClass, IntPtr info, uint length);
+    [DllImport("kernel32.dll", SetLastError = true)]
+    static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);
+
+    [StructLayout(LayoutKind.Sequential)]
+    struct JOBOBJECT_BASIC_LIMIT_INFORMATION
+    {
+        public long PerProcessUserTimeLimit, PerJobUserTimeLimit;
+        public uint LimitFlags;
+        public UIntPtr MinimumWorkingSetSize, MaximumWorkingSetSize;
+        public uint ActiveProcessLimit;
+        public UIntPtr Affinity;
+        public uint PriorityClass, SchedulingClass;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    struct IO_COUNTERS
+    {
+        public ulong ReadOperationCount, WriteOperationCount, OtherOperationCount, ReadTransferCount, WriteTransferCount, OtherTransferCount;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    struct JOBOBJECT_EXTENDED_LIMIT_INFORMATION
+    {
+        public JOBOBJECT_BASIC_LIMIT_INFORMATION BasicLimitInformation;
+        public IO_COUNTERS IoInfo;
+        public UIntPtr ProcessMemoryLimit, JobMemoryLimit, PeakProcessMemoryUsed, PeakJobMemoryUsed;
+    }
+}
diff --git a/with-nfltr/shared/SidecarChannel.cs b/with-nfltr/shared/SidecarChannel.cs
new file mode 100644
index 0000000..204474b
--- /dev/null
+++ b/with-nfltr/shared/SidecarChannel.cs
@@ -0,0 +1,49 @@
+// How the fleet's gRPC channels reach the nfltr connect sidecar: a
+// channel's target is a local endpoint of the sidecar. Stubs, calls, deadlines and streaming stay as they were.
+using System.IO.Pipes;
+using System.Net.Sockets;
+using Grpc.Net.Client;
+
+static class SidecarChannel
+{
+    // endpoint: "pipe:<name>" (Windows named pipe), "unix:<path>" (unix
+    // socket: Linux, macOS, Windows 10 1803+) or "host:port" (loopback TCP).
+    public static GrpcChannel For(string endpoint)
+    {
+        var handler = new SocketsHttpHandler();
+        if (endpoint.StartsWith("pipe:"))
+        {
+            var name = endpoint["pipe:".Length..];
+            handler.ConnectCallback = async (_, ct) =>
+            {
+                var pipe = new NamedPipeClientStream(".", name, PipeDirection.InOut, PipeOptions.Asynchronous);
+                await pipe.ConnectAsync(ct);
+                return pipe;
+            };
+            return Channel("http://localhost", handler); // the authority only; the callback connects
+        }
+        if (endpoint.StartsWith("unix:"))
+        {
+            var path = endpoint["unix:".Length..];
+            handler.ConnectCallback = async (_, ct) =>
+            {
+                var socket = new Socket(AddressFamily.Unix, SocketType.Stream, ProtocolType.Unspecified);
+                try
+                {
+                    await socket.ConnectAsync(new UnixDomainSocketEndPoint(path), ct);
+                }
+                catch
+                {
+                    socket.Dispose();
+                    throw;
+                }
+                return new NetworkStream(socket, ownsSocket: true);
+            };
+            return Channel("http://localhost", handler);
+        }
+        return Channel("http://" + endpoint, handler);
+    }
+
+    internal static GrpcChannel Channel(string address, SocketsHttpHandler handler) =>
+        GrpcChannel.ForAddress(address, new GrpcChannelOptions { HttpHandler = handler });
+}

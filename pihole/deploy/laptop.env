# The laptop's environment (beside relay.env): the config holding
# its relay certificate (nfltr config set-relay --code-file -) and its
# organisation enrolment (org/machine), and the system resolver set to the
# stub (127.0.0.1).
NFLTR_CONFIG=/run/ph/nfltr.json
DNS_SERVER=127.0.0.1:53
DNS_NET=udp

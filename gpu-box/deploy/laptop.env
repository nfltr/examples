# The laptop's environment (beside relay.env): the config holding
# its relay certificate (nfltr config set-relay --code-file -) and its
# organisation enrolment (org/machine), and any OpenAI-compatible tool
# pointed at the local endpoint.
NFLTR_CONFIG=/run/gb/nfltr.json
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Both machines: the relay. This test's private relay (TLS
# self-signed, pinned); with the hosted relay, nfltr config login on each
# machine saves the address and the machine's certificate instead, and this
# file goes away.
NFLTR_SERVER=10.232.2.10:8443
HTTP_SERVER_ADDR=https://10.232.2.10:8444
RPC_TLS=true
NFLTR_RELAY_CERT_SHA256=${RELAY_PIN}
